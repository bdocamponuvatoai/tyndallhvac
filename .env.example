# Copy to .env.local for local builds, or set these in the Vercel project.

# Public origin of the site, no trailing slash. Used for canonical URLs,
# Open Graph tags, the sitemap and structured data. If unset, falls back to
# Vercel's production domain, then http://localhost:3000.
SITE_URL=https://www.example.com

# Allow search engines to index the site. Keep "false" until the owner approves
# the launch. "true" requires SITE_URL to be the real public domain.
SITE_INDEXABLE=false
